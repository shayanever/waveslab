---
layout: post
---

{% assign post_img = page.image | default: page.thumbnail | default: page.preview %}

<div class="waveslab-news-post" style="display: flex; flex-wrap: wrap; gap: 2rem; align-items: flex-start; justify-content: space-between;">
  <div style="flex: 1 1 350px; min-width: 0;">
    {{ content }}
  </div>

  {% if post_img and post_img != "" %}
    <div style="flex: 0 0 280px; max-width: 280px; margin-left: auto;">
      {% include figure.liquid loading="eager" path=post_img class="img-fluid rounded z-depth-1" alt=page.title %}
      {% if page.image_caption %}
        <div class="caption">{{ page.image_caption }}</div>
      {% endif %}
    </div>
  {% endif %}
</div>

<hr style="margin-top: 2rem; margin-bottom: 1.5rem; border-top: 1px solid #e2e8f0;">
<link rel="stylesheet" href="{{ '/assets/css/theme-override.css' | relative_url }}">