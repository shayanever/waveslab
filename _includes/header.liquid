<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      
      <!-- Brand Logo / Title (FORCED VISIBLE ON ALL PAGES) -->
      <a class="navbar-brand title font-weight-lighter" href="{{ '/' | relative_url }}">
        {% if site.title == 'blank' %}
          <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }} {{ site.last_name }}
        {% else %}
          <span class="font-weight-bold">{{ site.title }}</span>
        {% endif %}
      </a>

      <!-- Navbar Toggle for Mobile -->
      <button class="navbar-toggler collapsed ml-auto" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">

          {% for page in site.pages %}
            {% if page.permalink == '/' %}
              {% assign home_title = page.title %}
            {% endif %}
          {% endfor %}

          <!-- Home tab -->
          {% if site.nav_home %}
            <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
              <a class="nav-link" href="{{ '/' | relative_url }}">
                {% if home_title %}{{ home_title }}{% else %}about{% endif %}
                {% if page.permalink == '/' %}
                  <span class="sr-only">(current)</span>
                {% endif %}
              </a>
            </li>
          {% endif %}

          <!-- Standard al-folio page loop -->
          {% assign sorted_pages = site.pages | sort: "nav_order" %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autotitle != 'home' %}
              <li class="nav-item {% if page.url contains p.url %}active{% endif %}">
                <a class="nav-link" href="{{ p.url | relative_url }}">
                  {{ p.title }}
                  {% if page.url contains p.url %}
                    <span class="sr-only">(current)</span>
                  {% endif %}
                </a>
              </li>
            {% endif %}
          {% endfor %}

          <!-- Search Toggle -->
          {% if site.search_enabled %}
            <li class="nav-item">
              <button id="search-toggle" class="btn nav-link" title="Search" aria-label="Search">
                <i class="fa-solid fa-magnifying-glass"></i>
              </button>
            </li>
          {% endif %}

          <!-- Toogle theme mode -->
          {% if site.enable_darkmode %}
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="fa-solid fa-moon"></i>
                <i class="fa-solid fa-sun"></i>
              </button>
            </li>
          {% endif %}

        </ul>
      </div>
    </div>
  </nav>
</header>