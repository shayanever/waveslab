<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-dark navbar-expand-md fixed-top" role="navigation" style="background-color: #0f3460 !important;">
    <div class="container d-flex justify-content-between align-items-center" style="max-width: 1180px;">
      
      <!-- Brand / Logo on Left (Light Text) -->
      <a class="navbar-brand title font-weight-lighter text-white" href="{{ '/' | relative_url }}">
        <span class="font-weight-bold" style="color: #ffffff !important;">WavesLab</span>
      </a>

      <!-- Navbar Toggler for Mobile -->
      <button class="navbar-toggler collapsed ml-auto" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <!-- Navbar Links -->
      <div class="collapse navbar-collapse justify-content-end" id="navbarNav" style="display: flex !important; visibility: visible !important;">
        <ul class="navbar-nav ml-auto flex-nowrap align-items-center">

          <!-- Home tab -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}" style="color: rgba(255, 255, 255, 0.9) !important;">
              Home
            </a>
          </li>

          <!-- Other Navigation Pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.permalink != '/' %}
              <li class="nav-item {% if page.url contains p.url %}active{% endif %}">
                <a class="nav-link" href="{{ p.url | relative_url }}" style="color: rgba(255, 255, 255, 0.9) !important;">
                  {% if p.title %}{{ p.title }}{% else %}{{ p.autotitle }}{% endif %}
                </a>
              </li>
            {% endif %}
          {% endfor %}

          <!-- Search toggle if enabled -->
          {% if site.search_enabled %}
            <li class="nav-item">
              <button id="search-toggle" class="btn nav-link ml-2" title="Search" aria-label="Search" style="color: rgba(255, 255, 255, 0.9) !important;">
                <i class="fa-solid fa-magnifying-glass"></i>
              </button>
            </li>
          {% endif %}

        </ul>
      </div>

    </div>
  </nav>
</header>